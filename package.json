{
  "name": "@getnote/dsh-plugin",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin for 得到大脑（Get笔记）",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib/",
    "skills/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown && tsc --emitDeclarationOnly --declaration --declarationMap --outDir lib/types",
    "check": "tsc --noEmit",
    "test": "node --test",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check && npm test && npm run build"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "getnote",
    "notes",
    "knowledge-base"
  ],
  "homepage": "https://github.com/iswalle/getnote-dsh-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iswalle/getnote-dsh-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/iswalle/getnote-dsh-plugin/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@getnote/cli": "^1.5.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-skill-filesystem": ">=0.1.0-rc.6 <1",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-skill-filesystem": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^22.0.0",
    "tsdown": "^0.12.9",
    "typescript": "^5.9.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
